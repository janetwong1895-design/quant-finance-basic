{
  "name": "quant-finance-basic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ten-chapter self-learning quantitative finance foundations prototype with optional Python.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:guide": "node scripts/build-guides.mjs",
    "start": "python3 -m http.server 8765 --bind 127.0.0.1 --directory dist",
